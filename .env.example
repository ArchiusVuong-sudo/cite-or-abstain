# Copy to .env and export, or set inline. Every variable is optional.
PORT=4104
HOST=127.0.0.1
# Force replay mode (recorded audit verdicts and base-model answers); also used when no login is found.
DEMO_REPLAY=0
# Model used by the audit, through the Claude Agent SDK on your local Claude Code login.
CLAUDE_MODEL=claude-sonnet-5-5
# Only needed if you are not logged in to Claude Code locally.
ANTHROPIC_API_KEY=
# Open base model that gets tuned.
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# auto picks Apple MPS when available, else CPU.
COA_DEVICE=auto
TRAIN_MAX_STEPS=60
# 0 = all test questions.
EVAL_LIMIT=0
COA_SEED=7
COA_DATA_DIR=var
# Where the llama.cpp converter lives (default var/llama.cpp, fetched by make fetch-converter).
LLAMA_CPP_DIR=
